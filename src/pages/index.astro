---
import Layout from '@/layouts/Layout.astro';
import Curtains from '@/components/sections/Curtains.astro';
import Hero from '@/components/sections/Hero.astro';
import VerticalParallax from '@/components/sections/VerticalParallax.astro';
import Skills from '@/components/sections/Skills.astro';
import Feed from '@/components/sections/Feed.astro';
import LandingFooter from '@/components/sections/LandingFooter.astro';
---

<Layout
  preloadImages={[
    { href: '/assets/images/cat_portrait.webp', type: 'image/webp' },
  ]}
>
  <Curtains />
  <div class="container-body">
    <div id="top-container" class="text-white">
      <Hero />
      <VerticalParallax />
      <Skills />
      <Feed />
      <LandingFooter />
    </div>
  </div>
</Layout>
